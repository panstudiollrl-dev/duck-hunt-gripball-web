# Signals emitted by this script
signal highscore_screen_continued
signal intro_screen_continued


# Initialize nodes used in script
@onready var bell_player = $AudioPlayers/BellPlayer
@onready var bg_atmosphere_player = $AudioPlayers/BgAtmospherePlayer
@onready var bg_music_player = $AudioPlayers/BgMusicPLayer
@onready var bullets_debug_label = $InfoElements/BulletsDebugLabel
@onready var bullets_info = $InfoElements/BulletsInfo
@onready var bullets_sprite = $InfoElements/BulletsInfo/Bullets
@onready var foreground = $Foreground
@onready var dog_node = $Dog
@onready var duck_points_label = $InfoElements/DuckPointsLabel
@onready var duck_quack_player = $AudioPlayers/DuckQuackPlayer
@onready var ducks_shot_sprite = $InfoElements/HitsInfo/DucksShot
@onready var ducks_unshot_sprite = $InfoElements/HitsInfo/DucksUnshot
@onready var game_over_player = $AudioPlayers/GameOverPlayer
@onready var game_over_sign = $InfoElements/GameOverSign
@onready var game_over_timer = $GameOverTimer
@onready var ground_dog_walk = $GroundDogWalk
@onready var hits_info = $InfoElements/HitsInfo
@onready var info_elements = $InfoElements
@onready var intro_screen = $IntroScreen
@onready var intro_screen_timer = $IntroScreenTimer
@onready var round_complete_sign = $InfoElements/RoundCompleteSign
@onready var round_info = $InfoElements/RoundInfo
@onready var round_start_sign = $InfoElements/RoundStartSign
@onready var round_label = $InfoElements/RoundInfo/RoundLabel
@onready var score_info = $InfoElements/ScoreInfo
@onready var score_label = $InfoElements/ScoreInfo/ScoreLabel
@onready var shotgun_empty_player = $AudioPlayers/ShotgunEmptyPlayer
@onready var shotgun_reload_player = $AudioPlayers/ShotgunReloadPlayer
@onready var shotgun_shot_player = $AudioPlayers/ShotgunShotPlayer
@onready var success_player = $AudioPlayers/SuccessPlayer
@onready var time_elapsed_label = $InfoElements/TimeElapsedLabel
@onready var top_edge_grass = $TopEdgeGrass
@onready var version_label = $VersionLabel


# Init duck node
@export var duck_node: PackedScene
@export var highscore_node: PackedScene
var duck
var highscore_screen
var party_ducks := {}
var intro_party_ducks := {}
var intro_players_hit := {}
# Set once the intro screen has been left, by whichever route got there first. Guards against a
# second intro_screen_continued landing in the started game.
var intro_continue_done := false
# Started when the first player hits their intro duck; see INTRO_PARTY_GRACE_SEC.
var intro_grace_timer: SceneTreeTimer = null
# True while the dog is up presenting a duck. There is one dog node, so overlapping runs would
# fight over its position; see _drain_dog_present_queue.
var dog_presenting := false
# Hit ducks waiting for the dog, oldest first. There is one dog and four players, so several
# ducks can land while it is already up; each entry is {"position", "type", "queued_at"}.
var dog_present_queue: Array = []
# When the last retrieval finished, for DOG_PRESENT_MIN_GAP_SEC. Negative so the first hit of a
# game is eligible rather than having to wait out a gap that never happened.
var dog_last_present_time := -1000.0
var party_player_count := 0
var party_mode := false
var party_spawning_players := {}


# General settings
# TODO: Expose (export) to Godot GUI?
# TODO: Expose to Player in a game settings menu?
var bonus_pts_per_round_multiplier = 1000
var bullets_debug_label_show = false
var bullets_width = 8
var debug_round_mode = false
var dog_start_position = Vector2(29, 164)
var duck_pts_round_multiplier = 0.75
var duck_speed_round_multiplier = 5
var ducks_shot_width = 8
var ducks_shot_sprite_default_width = 1
var ducks_to_shoot_per_round = 10
var game_over_timeout_sec_min = 4
var intro_min_delay_sec = 7
var max_bullets = 3
var max_score = 9999999
var play_dog_intro = true
var play_round_complete_animation = true
var points_per_duck = 500
var present_hit_duck = true
var round_compl_anim_blink_cnt = 4
var round_compl_anim_blink_delay = 0.25
var round_complete_msg_delay_after = 0.5
var round_complete_msg_prefix = "GREAT!\n"
var round_label_prefix = "R "
var round_start_msg_delay = 1.0
var round_start_msg_prefix = "Round\n"
var score_seperator = ","
var show_duck_points = true
var show_duck_points_delay = 0.35
var show_intro_screen = true


# Audio mix, in decibels. Keep music present while taming short SFX peaks.
const BG_MUSIC_VOLUME_DB = -9.0
const BG_ATMOSPHERE_VOLUME_DB = -12.0
const UI_SFX_VOLUME_DB = -6.0
const DUCK_SFX_VOLUME_DB = -8.0
const SHOTGUN_SFX_VOLUME_DB = -14.0
const SHOTGUN_RELOAD_VOLUME_DB = -16.0
const DOG_SFX_VOLUME_DB = -9.0

# How long the party intro screen will wait for every player to hit their duck before giving up
# and starting the game anyway.
#
# There was no escape from this wait at all, and Pan hit the consequence (2026-08-05: 畫面卡在
# 開頭打兩隻鴨子的地方 / 有一顆握力球做什麼都沒反應 進不了正式遊戲). One ball that enrols but
# never engages still gets an intro duck, and the screen waited for every duck, so a single dead
# ball locked the game out permanently with no way past it.
#
# Two fixes together: only players whose ball has actually pressed are required (see
# _intro_required_players), and this timeout backstops even that - the intro screen is a title
# card, and no fault in it is worth being unable to play.
const INTRO_PARTY_TIMEOUT_SEC = 20.0
# Once at least one player has hit their duck, the others get this much longer and then the game
# starts. Much shorter than the full timeout: one duck down proves the input path works, so
# anybody still missing is a hardware problem, not a player taking their time.
const INTRO_PARTY_GRACE_SEC = 8.0
# A queued duck older than this does not get a dog. The retrieval reads as "the dog is fetching
# the duck you just shot", and that reading has a shelf life: with one dog and four players a
# queue can build up, and coming up half a round later - after the duck has long gone and other
# ducks have been shot - is exactly the 不對的時間點 / 根本就不是我們打到的鴨子 Pan reported
# (2026-08-06). Late entries are dropped rather than shown, because no dog is better than a dog
# holding a duck nobody remembers shooting.
const DOG_PRESENT_MAX_AGE_SEC = 2.5
# How often a hit duck gets the dog at all. Pan, 2026-08-06: 狗太常出來了 可以隨機的間歇式的
# 偶爾出現就好.
#
# Once the queue was fixed the dog came up for essentially every kill, and with four players
# that is a lot of kills - so what was meant as a little reward became the常態 and stopped
# registering as one. It is a treat, and a treat has to be rare enough to notice.
#
# Note this is per hit duck, not per second: four players shooting means four rolls, so the dog
# is seen roughly as often here as a single player at 4x the rate. DOG_PRESENT_MIN_GAP_SEC is
# what keeps that from clustering.
const DOG_PRESENT_CHANCE = 0.22
# Even at 0.22 an unlucky run of rolls puts the dog up twice in a row, which reads as broken
# rather than as random. Nothing is presented until this long after the last retrieval ended -
# a floor on the gap, so "occasional" stays occasional in the short term as well as on average.
const DOG_PRESENT_MIN_GAP_SEC = 12.0


# Shuffle bag for duck types to increase "randomness feel"
# by preventing the same duck type of getting picked directly after each other
# See https://docs.godotengine.org/en/stable/tutorials/math/random_number_generation.html#better-randomness-using-shuffle-bags
var duck_types_shuffle_bag = []


# Status variables
var browser_game = OS.has_feature("web")
var ignore_shots = false
var ducks_shot = 0

var bullets_current = max_bullets:
	# setter runs when the variable value is changed
	set(value):
		# prevent bullets from becoming negative
		if value >= 0:
			bullets_current = value
			bullets_debug_label.text = str(value)

var round_current = 1:
	set(value):
		round_current = value
		round_label.text = round_label_prefix + str(value)

var score_current = 0:
	set(value):
		if value > max_score:
			value = max_score
		score_current = value
		score_label.text = format_score(str(value))

var time_elapsed = 0
var time_elapsed_min = 0
var time_elapsed_sec = 0
var time_elapsed_string = str("00:00")
var time_now = 0
var time_start = 0


### Use for debugging/testing only!
var quick_debug_mode = false


# Called when the node enters the scene tree for the first time.
# Can be considered as main() as we know it from Python, C, etc. ;)
func _ready():
	### For testing/debugging
	#AudioServer.set_bus_mute(0, true)
	###
	ignore_shots = true
	_apply_audio_mix()
	# randomize() should be called in _ready() in main scene
	# See https://docs.godotengine.org/en/stable/tutorials/math/random_number_generation.html
	randomize()
	_init_labels()
	bg_music_player.play()
	if not GripballInput.calibration_complete:
		await GripballInput.calibration_finished
	party_mode = GripballInput.party_mode
	party_player_count = maxi(GripballInput.player_count, 1)
	if party_mode:
		print("Gripball party mode: " + str(party_player_count) + " player(s)")
		# The dog stays. Pan asked for the retrieval back (2026-08-05: 我記得 先前版本都把狗抓到
		# 鴨子的橋段刪掉了 但其實那很可愛) - it was never deleted, just switched off here.
		#
		# Only the retrieval, though. play_dog_intro is the sniff-and-jump that runs BEFORE the
		# first duck and is awaited by _ready(), which would hold four players on a static screen
		# for ~7s with nothing to do; the retrieval is a ~1.7s reaction to something they just
		# did, and in Party Mode it does not block anybody (see _drain_dog_present_queue).
		play_dog_intro = false
		present_hit_duck = true
		max_bullets = maxi(max_bullets, party_player_count * 99)
	### Quick debug mode
	if quick_debug_mode:
		print("\nATTENTION: Quick debug mode enabled!\n")
		bullets_debug_label_show = true
		debug_round_mode = true
		play_dog_intro = false
		play_round_complete_animation = false
		present_hit_duck = false
		show_intro_screen = false
	###
	if show_intro_screen:
		await _show_intro_screen()
	print("\nStarting new game...")
	print("Round " + str(round_current))
	time_start = Time.get_unix_time_from_system()
	print("time_start (unix seconds): " + str(time_start))
	print(
			"Started game at " +
			str(Time.get_datetime_string_from_unix_time(time_start))
	)
	_reset_ducks_shot()
	_reload_shotgun()
	bg_atmosphere_player.play()
	#print("dog_node.position: " + str(dog_node.position))
	if play_dog_intro:
		await _dog_jump_into_grass()
	await _show_round_start_sign()
	await get_tree().create_timer(1).timeout
	if party_mode:
		await _spawn_party_ducks()
	else:
		await _spawn_duck()
	ignore_shots = false


func _apply_audio_mix() -> void:
	bg_music_player.volume_db = BG_MUSIC_VOLUME_DB
	bg_atmosphere_player.volume_db = BG_ATMOSPHERE_VOLUME_DB
	bell_player.volume_db = UI_SFX_VOLUME_DB
	success_player.volume_db = UI_SFX_VOLUME_DB
	game_over_player.volume_db = UI_SFX_VOLUME_DB
	duck_quack_player.volume_db = DUCK_SFX_VOLUME_DB
	shotgun_empty_player.volume_db = SHOTGUN_SFX_VOLUME_DB
	shotgun_shot_player.volume_db = SHOTGUN_SFX_VOLUME_DB
	shotgun_reload_player.volume_db = SHOTGUN_RELOAD_VOLUME_DB

	var dog_bark_player = dog_node.get_node_or_null("DogBarkPlayer")
	if dog_bark_player:
		dog_bark_player.volume_db = DOG_SFX_VOLUME_DB
	var dog_laugh_player = dog_node.get_node_or_null("DogLaughPlayer")
	if dog_laugh_player:
		dog_laugh_player.volume_db = DOG_SFX_VOLUME_DB


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta):
	if time_start > 0:
		time_now = Time.get_unix_time_from_system()
		time_elapsed = time_now - time_start
		# Inspired by https://ask.godotengine.org/3641/how-display-elapsed-time-in-game
		time_elapsed_min = int(time_elapsed / 60)
		time_elapsed_sec = int(time_elapsed) % 60
		# For details on GDScript string formatting, see
		# https://docs.godotengine.org/en/stable/tutorials/scripting/gdscript/gdscript_format_string.html#padding
		time_elapsed_string = str("%02d:%02d") % [time_elapsed_min, time_elapsed_sec]
		time_elapsed_label.text = time_elapsed_string
		#print("Time elapsed: " + time_elapsed_string)


func _show_highscore_screen():
	var _online_str = " local "
	if browser_game:
		_online_str = " online "
	print("Showing" + _online_str + "highscore screen")
	ignore_shots = true
	# Anything still waiting for the dog belongs to a game that is now over.
	dog_present_queue.clear()
	if duck:
		duck.queue_free()
	for _player_id in party_ducks.keys():
		var _party_duck = party_ducks[_player_id]
		if is_instance_valid(_party_duck):
			_party_duck.queue_free()
	party_ducks.clear()
	highscore_screen = highscore_node.instantiate()
	# Runs _ready() of HighscoreScreen()
	get_tree().current_scene.add_child(highscore_screen)
	highscore_screen.highscore_continued.connect(_on_highscore_continued)
	info_elements.hide()
	bg_music_player.stop()
	### Testing/debugging only
	if quick_debug_mode:
		score_current += 1234567
		#await get_tree().create_timer(2).timeout
	###
	await highscore_screen.init_highscore()
	await highscore_screen.check_if_new_highscore(score_current)
	if highscore_screen.continue_button:
		### Testing/debugging only
		#if quick_debug_mode:
		#	await get_tree().create_timer(2).timeout
		###
		highscore_screen.continue_button.show()
		await highscore_screen_continued


# Attention:
# If your overlay scenes/screens, like intro, credits, etc.
# contain a ColorRect object, for instance as a background box,
# then you need to set 'mouse_filter' (Inspector -> Mouse -> Filter)
# to 'Ignore' or 'Pass', otherwise input_event signals will get blocked
# for _all_ other nodes/objects in the tree, even if their layer is above
# the background box! This lost me hours of debugging!
#
# See the related GitHub issue #84796:
# https://github.com/godotengine/godot/issues/84796
func _show_intro_screen():
	print("Showing intro screen")
	ignore_shots = true
	info_elements.hide()
	version_label.show()
	intro_screen.show()
	(
			intro_screen.get_node("CreditsButton").pressed.
			connect(_on_credits_btn_pressed)
	)
	intro_screen.get_node("CreditsScreen").hide()
	(
			intro_screen.get_node("CreditsScreen/BackButton").pressed.
			connect(_on_credits_back_btn_pressed)
	)
	var _continue_label = intro_screen.get_node("ContinueLabel")
	_continue_label.hide()
	bg_atmosphere_player.stop()
	intro_screen_timer.start()
	await intro_screen_timer.timeout
	await _spawn_intro_screen_duck()
	_continue_label.show()
	if party_mode:
		_continue_label.text = "AIM + FLICK ALL PLAYERS"
		_continue_label.position = Vector2(18, 205)
	else:
		_continue_label.position = Vector2(
				max(18, duck.position.x - _continue_label.size.x - 25),
				clampf(duck.position.y - (_continue_label.size.y * 0.5), 120, 210),
		)
	var _anim_player = intro_screen.get_node("AnimationPlayer")
	_anim_player.get_animation("blink_continue_text").set_loop_mode(true)
	_anim_player.play("blink_continue_text")
	if party_mode:
		# Never a bare await here. See INTRO_PARTY_TIMEOUT_SEC: the signal is only emitted when
		# every required player has hit their duck, and a ball that cannot engage will never hit
		# anything, so an unbacked await is an unrecoverable lock-out of the whole game.
		await _await_intro_continue()
	else:
		await intro_screen_continued
	_anim_player.stop()
	_continue_label.hide()
	await _exit_intro_screen()


# Wait for the intro screen to be finished, but never indefinitely.
#
# Races the real "everybody hit their duck" signal against a timeout. Whichever comes first
# wins, and intro_continue_done makes sure the loser cannot fire a second continue into a game
# that has already started.
func _await_intro_continue() -> void:
	var timeout := get_tree().create_timer(INTRO_PARTY_TIMEOUT_SEC)
	timeout.timeout.connect(_on_intro_party_timeout)
	while not intro_continue_done:
		await intro_screen_continued
	if timeout.timeout.is_connected(_on_intro_party_timeout):
		timeout.timeout.disconnect(_on_intro_party_timeout)


func _start_intro_grace() -> void:
	if intro_continue_done or intro_grace_timer != null:
		return
	intro_grace_timer = get_tree().create_timer(INTRO_PARTY_GRACE_SEC)
	intro_grace_timer.timeout.connect(_on_intro_grace_timeout)


func _on_intro_grace_timeout() -> void:
	intro_grace_timer = null
	if intro_continue_done:
		return
	print("Intro screen grace period elapsed, starting with " +
			str(_intro_players_waiting().size()) + " player(s) still waiting")
	_finish_intro_screen()


func _on_intro_party_timeout() -> void:
	if intro_continue_done:
		return
	push_warning(
			"Intro screen timed out after " + str(INTRO_PARTY_TIMEOUT_SEC) +
			"s - starting anyway. Players still waiting: " + str(_intro_players_waiting())
	)
	print("Intro screen timed out, starting game anyway")
	_finish_intro_screen()


# The players the intro screen is allowed to wait for: those whose ball has been seen to press.
#
# An enrolled ball is not a working ball. It can be authorized, opened and streaming pressure
# reports and still never cross its engage bar, in which case it can neither track nor shoot -
# and requiring it to hit a duck is requiring something impossible. GripballInput marks a player
# proven on their first real press (signal player_proven).
#
# If nobody has pressed yet, every player is required: that is the normal state a fraction of a
# second after the screen appears, and dropping the requirement then would start the game before
# anyone had touched anything.
func _intro_required_players() -> Array:
	var proven: Array = []
	for player_id in intro_players_hit.keys():
		if bool(GripballInput.players_proven.get(player_id, false)):
			proven.append(player_id)
	if proven.is_empty():
		return intro_players_hit.keys()
	return proven


func _intro_players_waiting() -> Array:
	var waiting: Array = []
	for player_id in _intro_required_players():
		if not bool(intro_players_hit.get(player_id, false)):
			waiting.append(player_id + 1)
	return waiting


# Leave the intro screen for good. Idempotent, because it is reachable from three places (the
# last duck being hit, the grace timer, and the overall timeout) and any two of them can be in
# flight at once - a second continue would land in the running game.
func _finish_intro_screen() -> void:
	if intro_continue_done:
		return
	intro_continue_done = true
	var anim = intro_screen.get_node_or_null("AnimationPlayer")
	if anim:
		anim.stop()
	var label = intro_screen.get_node_or_null("ContinueLabel")
	if label:
		label.hide()
	intro_screen_continued.emit()


func _spawn_intro_screen_duck():
	if party_mode:
		await _spawn_party_intro_ducks()
		return
	duck = duck_node.instantiate()
	duck.show()
	duck.velocity = Vector2.ZERO
	var _viewport_height = ProjectSettings.get_setting("display/window/size/viewport_height")
	var _viewport_width = ProjectSettings.get_setting("display/window/size/viewport_width")
	var _duck_width = ceil(duck.get_node("CollisionShape2D").get_shape().get_rect().size.x)
	var _duck_height = ceil(duck.get_node("CollisionShape2D").get_shape().get_rect().size.y)
	var _btn_x = _viewport_width - (_duck_width * 0.5) - 10
	var _btn_y = _viewport_height - (_duck_height * 0.5) - 10
	duck.position = Vector2(_btn_x, _btn_y)
	# Attention: This runs _ready() of Duck scene!
	intro_screen.add_child(duck)
	duck.wings_flap_player.stop()
	duck.duck_random_quack = false
	duck.input_pickable = true
	duck.next_duck.connect(_on_next_duck)


func _spawn_party_intro_ducks():
	for old_duck in intro_party_ducks.values():
		if old_duck and is_instance_valid(old_duck):
			old_duck.queue_free()
	intro_party_ducks.clear()
	intro_players_hit.clear()
	var _viewport_height = ProjectSettings.get_setting("display/window/size/viewport_height")
	var _viewport_width = ProjectSettings.get_setting("display/window/size/viewport_width")
	var occupied_spacing := 26.0
	for player_id in range(party_player_count):
		var intro_duck = duck_node.instantiate()
		if player_id == 0:
			duck = intro_duck
		intro_duck.name = "IntroDuckPlayer" + str(player_id + 1)
		# Marks this duck as belonging to the title card, so a next_duck emitted after the screen
		# is hidden can be told apart from a real in-round duck - see _on_next_duck.
		intro_duck.set_meta("intro_duck", true)
		intro_duck.show()
		intro_duck.velocity = Vector2.ZERO
		var _duck_width = ceil(intro_duck.get_node("CollisionShape2D").get_shape().get_rect().size.x)
		var _duck_height = ceil(intro_duck.get_node("CollisionShape2D").get_shape().get_rect().size.y)
		var _btn_x = clampf(
			_viewport_width - (_duck_width * 0.5) - 10 - (float(party_player_count - 1 - player_id) * occupied_spacing),
			_duck_width * 0.5 + 8,
			_viewport_width - (_duck_width * 0.5) - 8
		)
		var _btn_y = _viewport_height - (_duck_height * 0.5) - 10
		intro_duck.position = Vector2(_btn_x, _btn_y)
		intro_screen.add_child(intro_duck)
		intro_duck.wings_flap_player.stop()
		intro_duck.duck_random_quack = false
		intro_duck.input_pickable = true
		intro_duck.next_duck.connect(_on_next_duck.bind(intro_duck, player_id))
		_add_party_player_label(intro_duck, player_id)
		intro_party_ducks[player_id] = intro_duck
		intro_players_hit[player_id] = false


func _exit_intro_screen():
	# Attention: hide() will "kill" instantiated duck
	# (signal screen_exited())!
	intro_screen.hide()
	info_elements.show()
	version_label.hide()
	print("Leaving intro screen...")


func _on_highscore_continued():
	highscore_screen.hide()
	highscore_screen.queue_free()
	highscore_screen_continued.emit()
	print("Leaving highscore screen")


func _on_intro_screen_timeout() -> void:
	print(
			"Intro screen timer ran for " +
			str(intro_screen_timer.get_wait_time())
			+ " seconds"
	)


func _on_credits_btn_pressed():
	if duck:
		duck.input_pickable = false
	intro_screen.get_node("CreditsScreen").show()


func _on_credits_back_btn_pressed():
	intro_screen.get_node("CreditsScreen").hide()
	if duck:
		duck.input_pickable = true


func _init_labels():
	game_over_sign.hide()
	round_complete_sign.hide()
	round_start_sign.hide()
	duck_points_label.hide()
	version_label.hide()
	bullets_debug_label.visible = bullets_debug_label_show
	bullets_debug_label.text = str(bullets_current)
	round_label.text = round_label_prefix + str(round_current)
	score_label.text = str(score_current)
	time_elapsed_label.text = time_elapsed_string
	version_label.z_index=999
	version_label.text = str(
			"v" + ProjectSettings.get_setting("application/config/version")
	)
	print("Version info: " + version_label.text)


# Intro: Dog sniffs on ground, hears a duck and then jumps into the grass
# TODO: Refactor potentially redundant code with functions "_dog_laugh" and "_dog_present_duck"
func _dog_jump_into_grass():
	if dog_node.z_index < foreground.z_index:
		dog_node.z_index = foreground.z_index + 1
	dog_node.show()
	dog_node.get_node("AnimatedSprite2D").play("sniff")
	await get_tree().create_timer(2).timeout
	duck_quack_player.play()
	await get_tree().create_timer(0.3).timeout
	dog_node.get_node("AnimatedSprite2D").play("attention")
	dog_node.velocity = Vector2.ZERO
	await get_tree().create_timer(1).timeout
	# Attention:
	# Be careful when playing keyframe animations that change the position
	# of the contained AnimatedSprite2D and CollisionShape2D!
	# If you forget to also insert respective position keyframes for the
	# CollisionShape2D, you will get a strange difference in position
	# if you run the animation which can cost you _hours_ of debugging!
	# Trust me, I know it... :-/
	#print("dog_node.position: " + str(dog_node.position))
	dog_node.get_node("AnimationPlayer").play("jump_in_grass")
	#print("dog_node.position: " + str(dog_node.position))
	dog_node.get_node("CollisionShape2D").set_disabled(true)
	await get_tree().create_timer(0.1).timeout
	dog_node.get_node("DogBarkPlayer").play()
	await get_tree().create_timer(0.9).timeout
	dog_node.z_index = foreground.z_index - 1
	await get_tree().create_timer(0.55).timeout
	dog_node.hide()
	#print("dog_node.position: " + str(dog_node.position))
	dog_node.get_node("AnimationPlayer").play("RESET")
	#print("dog_node.position: " + str(dog_node.position))
	await get_tree().create_timer(1.5).timeout
	dog_node.get_node("CollisionShape2D").set_disabled(false)


# Game Over: Dog laughs at Player
# TODO: Refactor potentially redundant code with functions "_dog_present_duck" and "_dog_jump_into_grass"
func _dog_laugh():
	dog_node.hide()
	dog_node.velocity = Vector2.ZERO
	dog_node.get_node("AnimatedSprite2D").play("laugh")
	dog_node.get_node("CollisionShape2D").set_disabled(true)
	if dog_node.z_index >= foreground.z_index - 1:
		dog_node.z_index = foreground.z_index - 1
	# Determine x position for laughing dog at middle of viewport
	# See https://docs.godotengine.org/en/stable/classes/class_projectsettings.html
	var _viewport_width = ProjectSettings.get_setting("display/window/size/viewport_width")
	# Need to get best estimate of dog's height while presenting duck,
	# as default animation is "sniff" in which dog's height is much smaller.
	# This is needed to calculate how to hide dog inside grass.
	# Could be avoided by having seperate AnimatedSprite2D nodes in dog scene,
	# but this would make switching dog animations more complex.
	var _frame_count = (
			dog_node.get_node("AnimatedSprite2D").
			get_sprite_frames().get_frame_count("laugh")
	)
	var _last_frame = (
			dog_node.get_node("AnimatedSprite2D").
			get_sprite_frames().get_frame_texture("laugh", _frame_count-1)
	)
	var _dog_width = _last_frame.get_width()
	var _dog_height = _last_frame.get_height()
	# TODO: Make these multipliers configurable?
	var _dog_hidden_in_grass_y = foreground.region_rect.size.y + (_dog_height * 1.6)
	var _dog_hide_y_offset = _dog_height * 1.33
	#print("viewport_width: " + str(_viewport_width))
	#print("dog_width: " + str(_dog_width))
	#print("dog_height: " + str(_dog_height))
	#print("dog_hidden_in_grass_y: " + str(_dog_hidden_in_grass_y))
	#print("dog_hide_y_offset: " + str(_dog_hide_y_offset))
	var _new_x = roundi(_viewport_width * 0.5)
	var _new_y = roundi(_dog_hidden_in_grass_y)
	var _new_position = Vector2(_new_x, _new_y)
	#print("dog_node.position new: " + str(_new_position))
	# Dog slides up from new position
	# TODO: Move this into a function?
	dog_node.position = _new_position
	dog_node.get_node("DogLaughPlayer").play()
	dog_node.show()
	await get_tree().create_timer(0.5).timeout
	dog_node.velocity = Vector2(0, -1 * _dog_hide_y_offset)
	await get_tree().create_timer(0.5).timeout
	dog_node.velocity = Vector2.ZERO
	await get_tree().create_timer(2).timeout
	# Dog slides back down, avoiding collision
	# TODO: Move this into a function?
	dog_node.velocity = Vector2(0, _dog_hide_y_offset)
	await get_tree().create_timer(0.5).timeout
	dog_node.velocity = Vector2.ZERO
	dog_node.hide()
	dog_node.get_node("CollisionShape2D").set_disabled(false)
	await get_tree().create_timer(0.5).timeout


# Party Mode's route into _dog_present_duck. Fire-and-forget on purpose - see the call site in
# _on_next_duck - and serialised, because there is one dog: two ducks landing at once would
# otherwise both reposition and re-show the same node, and the second would cut the first off
# mid-slide and leave the dog stranded (its own animation restores position, so an interrupted
# run does not restore it).
#
# Most hits get no dog at all: see DOG_PRESENT_CHANCE. The roll happens here rather than in the
# drain so that a duck the dog is not coming for never takes up a place in the queue, and so a
# decline costs nothing and cannot delay the next duck that does win.
#
# With those gates in place the queue holds at most one entry - _dog_should_present() declines
# while anything is queued or presenting - so DOG_PRESENT_MAX_AGE_SEC is now a backstop rather
# than the load-bearing part it was when every hit queued. It stays because it is what stops a
# dog answering a duck nobody remembers shooting, and it is the gates, not the age check, that
# would have to be re-reasoned if the rarity ever changes.
func _queue_hit_duck_for_dog(_duck_hit_position, _duck_type) -> void:
	if not _dog_should_present():
		return
	dog_present_queue.append({
		"position": _duck_hit_position,
		"type": _duck_type,
		"queued_at": Time.get_ticks_msec() / 1000.0,
	})
	if dog_presenting:
		return
	_drain_dog_present_queue()


# Whether this hit duck gets the dog. Two gates: a minimum gap since the last retrieval, so two
# dogs cannot land back to back, and then a plain random roll.
#
# The gap is checked against the queue as well as the last finished retrieval - with four players
# several ducks can be in flight at once, and a win already sitting in the queue is a dog that
# has not happened yet but is about to.
func _dog_should_present() -> bool:
	if not dog_present_queue.is_empty():
		return false
	var now := Time.get_ticks_msec() / 1000.0
	if dog_presenting or now - dog_last_present_time < DOG_PRESENT_MIN_GAP_SEC:
		return false
	return randf() < DOG_PRESENT_CHANCE


func _drain_dog_present_queue() -> void:
	if dog_presenting:
		return
	dog_presenting = true
	while not dog_present_queue.is_empty():
		var entry: Dictionary = dog_present_queue.pop_front()
		# Age is measured from the hit, not from reaching the front of the queue, so a backlog
		# expires rather than replaying itself in slow motion.
		var age := (Time.get_ticks_msec() / 1000.0) - float(entry.get("queued_at", 0.0))
		if age > DOG_PRESENT_MAX_AGE_SEC:
			print("Skipping dog retrieval, duck was shot " + str(snappedf(age, 0.1)) + "s ago")
			continue
		# Nothing to present once the round is over or the board has been torn down: the dog
		# would be climbing out of the grass over the game over sign or the highscore screen.
		if not game_over_timer.is_stopped() or intro_screen.visible:
			dog_present_queue.clear()
			break
		await _dog_present_duck(entry.get("position"), entry.get("type"))
		# Stamped after the animation, so DOG_PRESENT_MIN_GAP_SEC is a gap between retrievals
		# rather than between their start times (the animation is ~1.7s of that on its own).
		dog_last_present_time = Time.get_ticks_msec() / 1000.0
	dog_presenting = false


# Dog presents hit duck after it fell into grass
# TODO: Refactor potentially redundant code with functions "_dog_laugh" and "_dog_jump_into_grass"
func _dog_present_duck(_duck_hit_position, _duck_type):
	dog_node.hide()
	dog_node.velocity = Vector2.ZERO
	var _has_anim = (
			dog_node.get_node("AnimatedSprite2D").
			get_sprite_frames().
			has_animation("present_duck_" + _duck_type)
	)
	var _anim_name = "present_duck"
	if _has_anim:
		_anim_name = "present_duck_" + _duck_type
	if not _duck_type.is_empty() and _has_anim:
		dog_node.get_node("AnimatedSprite2D").play(_anim_name)
	dog_node.get_node("CollisionShape2D").set_disabled(true)
	if dog_node.z_index >= foreground.z_index - 1:
		dog_node.z_index = foreground.z_index - 1
	# Need to get best estimate of dog's height while presenting duck,
	# as default animation is "sniff" in which dog's height is much smaller.
	# This is needed to calculate how to hide dog inside grass.
	# Could be avoided by having seperate AnimatedSprite2D nodes in dog scene,
	# but this would make switching dog animations more complex.
	var _frame_count = (
			dog_node.get_node("AnimatedSprite2D").
			get_sprite_frames().get_frame_count("present_duck")
	)
	var _last_frame = (
			dog_node.get_node("AnimatedSprite2D").
			get_sprite_frames().get_frame_texture("present_duck", _frame_count-1)
	)
	var _dog_width = _last_frame.get_width()
	var _dog_height = _last_frame.get_height()
	# TODO: Make these multipliers configurable?
	var _dog_hidden_in_grass_y = foreground.region_rect.size.y + (_dog_height * 1.6)
	var _dog_hide_y_offset = _dog_height * 1.33
	#print("dog_width: " + str(_dog_width))
	#print("dog_height: " + str(_dog_height))
	#print("dog_hidden_in_grass_y: " + str(_dog_hidden_in_grass_y))
	#print("dog_hide_y_offset: " + str(_dog_hide_y_offset))
	var _new_x = roundi(_duck_hit_position.x)
	var _new_y = roundi(_dog_hidden_in_grass_y)
	var _new_position = Vector2(_new_x, _new_y)
	#print("dog_node.position new: " + str(_new_position))
	# Dog slides up from new position
	# TODO: Move this into a function?
	dog_node.position = _new_position
	dog_node.show()
	dog_node.velocity = Vector2(0, -1 * _dog_hide_y_offset)
	await get_tree().create_timer(0.5).timeout
	dog_node.velocity = Vector2.ZERO
	dog_node.get_node("DogBarkPlayer").play()
	await get_tree().create_timer(0.2).timeout
	# Dog slides back down, avoiding collision
	# TODO: Move this into a function?
	dog_node.velocity = Vector2(0, _dog_hide_y_offset)
	await get_tree().create_timer(0.5).timeout
	dog_node.velocity = Vector2.ZERO
	dog_node.hide()
	dog_node.get_node("CollisionShape2D").set_disabled(false)
	await get_tree().create_timer(0.5).timeout


# Create (spawn) a new duck with a random x position
# and a random direction angle 0 - 180°.
# The starting y position is inside the grass (below TopEdgeGrass'es y position),
# which is why we need to deactivate collision until the duck is in the air.
# Otherwise the duck would always bounce downwards and disappear.
#
# Attention:
# Assumes that TopEdgeGrass'es CollisionShape2D has one_way_collision enabled!
func _spawn_duck(player_id := -1):
	if player_id >= 0:
		var existing_duck = party_ducks.get(player_id)
		if existing_duck and is_instance_valid(existing_duck):
			return existing_duck
		if party_spawning_players.get(player_id, false):
			return null
		party_spawning_players[player_id] = true
	top_edge_grass.get_node("CollisionShape2D").set_disabled(true)
	var new_duck = duck_node.instantiate()
	if player_id < 0:
		duck = new_duck
	else:
		new_duck.name = "DuckPlayer" + str(player_id + 1)
		party_ducks[player_id] = new_duck
	new_duck.input_pickable = false
	new_duck.velocity = Vector2.ZERO
	new_duck.speed += duck_speed_round_multiplier * round_current
	new_duck.next_duck.connect(_on_next_duck.bind(new_duck, player_id))
	new_duck.hide()
	# Increase "randomness feeling" of duck types getting spawned by using a shuffle bag
	# See https://docs.godotengine.org/en/stable/tutorials/math/random_number_generation.html#better-randomness-using-shuffle-bags
	if duck_types_shuffle_bag.is_empty():
		duck_types_shuffle_bag = new_duck.duck_types.duplicate()
		duck_types_shuffle_bag.shuffle()
	var _random_duck = duck_types_shuffle_bag.pop_back()
	new_duck.current_duck_type = _random_duck
	new_duck.get_node("AnimatedSprite2D").play(_random_duck + new_duck.duck_fly_animation_suffix)
	var _viewport_width = ProjectSettings.get_setting("display/window/size/viewport_width")
	var _duck_width = ceil(new_duck.get_node("CollisionShape2D").get_shape().get_rect().size.x)
	var _duck_height = ceil(new_duck.get_node("CollisionShape2D").get_shape().get_rect().size.y)
	var _duck_hidden_in_grass_y = floor(
			top_edge_grass.get_node("CollisionShape2D").position.y
			+ ceil(
					top_edge_grass.get_node("CollisionShape2D").get_shape().
					get_rect().size.y * 0.5
			)
	)
	var _min_x = 0 + (_duck_width * 0.5)
	var _max_x = _viewport_width - (_duck_width * 0.5)
	if player_id >= 0 and party_player_count > 1:
		var lane_width = float(_viewport_width) / float(party_player_count)
		_min_x = max(_min_x, player_id * lane_width + (_duck_width * 0.5))
		_max_x = min(_max_x, (player_id + 1) * lane_width - (_duck_width * 0.5))
	var _new_x = randi_range(roundi(_min_x), roundi(max(_min_x, _max_x)))
	var _new_y = _duck_hidden_in_grass_y
	var _new_position = Vector2(_new_x, _new_y)
	new_duck.position = _new_position
	#print("viewport_width: " + str(_viewport_width))
	#print("duck_width: " + str(_duck_width))
	#print("duck_height: " + str(_duck_height))
	#print("duck_hidden_in_grass_y: " + str(_duck_hidden_in_grass_y))
	#print("duck.position new: " + str(_new_position))
	# Attention: This runs _ready() of Duck scene!
	get_tree().current_scene.add_child(new_duck)
	if player_id >= 0:
		_add_party_player_label(new_duck, player_id)
	new_duck.show()
	new_duck.velocity = new_duck.random_up_direction() * new_duck.speed
	new_duck.input_pickable = true
	top_edge_grass.get_node("CollisionShape2D").set_disabled(false)
	if player_id >= 0:
		party_spawning_players.erase(player_id)
	return new_duck


func _spawn_party_ducks():
	for old_duck in party_ducks.values():
		if old_duck and is_instance_valid(old_duck):
			old_duck.queue_free()
	party_ducks.clear()
	party_spawning_players.clear()
	for player_id in range(party_player_count):
		await _spawn_duck(player_id)
		await get_tree().create_timer(0.12).timeout


func _add_party_player_label(target_duck, player_id: int) -> void:
	var label := Label.new()
	label.name = "GripballPlayerLabel"
	label.text = str(player_id + 1)
	label.position = Vector2(-6, -23)
	label.size = Vector2(24, 14)
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	label.add_theme_font_size_override("font_size", 12)
	label.add_theme_color_override("font_color", Color(1.0, 0.75, 0.12))
	label.add_theme_color_override("font_outline_color", Color.BLACK)
	label.add_theme_constant_override("outline_size", 4)
	label.z_index = 999
	target_duck.add_child(label)


# Function connected to "next_duck" signal from Duck scene
func _on_next_duck(source_duck = null, player_id := -1):
	var active_duck = duck if source_duck == null else source_duck
	if active_duck.has_meta("intro_duck") and not intro_screen.visible:
		# The intro ducks are children of intro_screen, and hiding it trips their
		# VisibleOnScreenNotifier2D - _exit_intro_screen() says as much in its own comment. So
		# every intro duck emits next_duck one last time, AFTER intro_screen.visible has already
		# gone false, and those emissions used to fall straight through into the gameplay
		# branches below: they scored points, advanced ducks_shot, queued a respawn, and sent
		# the dog up holding an intro duck at the exact moment the round began.
		#
		# That is the dog Pan saw (2026-08-06: 狗都在不對的時間點爬出來 根本就不是我們打到的鴨子).
		# It was never showing the duck they had just shot in the round - it was showing the
		# title-card duck from before the game started.
		#
		# Single player is unaffected and must stay that way: there the intro duck falls off the
		# bottom of the screen while the card is still up, and that emission is what continues
		# the game (see the elif below). Hence the visible check rather than a blanket return.
		return
	var _duck_hit_position = active_duck.duck_hit_position
	var _duck_type = active_duck.current_duck_type
	if party_mode and player_id >= 0:
		if party_ducks.get(player_id) == active_duck:
			party_ducks.erase(player_id)
		party_spawning_players.erase(player_id)
		if not intro_screen.visible:
			if active_duck.duck_hit:
				# Queue the dog BEFORE the scoreboard await. _increase_ducks_shot() waits 0.5s
				# (1s on the last duck of a round), and queuing after it put the dog that much
				# further from the moment of the hit for no reason.
				#
				# Deliberately not awaited: in Party Mode every player has their own duck and
				# their own respawn clock, so waiting out a ~1.7s animation would stall that
				# player's next duck, and with four players stall it repeatedly.
				if present_hit_duck:
					_queue_hit_duck_for_dog(_duck_hit_position, _duck_type)
				await _increase_ducks_shot()
				score_current += points_per_duck
			await get_tree().create_timer(0.45).timeout
			if game_over_timer.is_stopped():
				await _spawn_duck(player_id)
		return
	if (
			game_over_timer.is_stopped()
			and not intro_screen.visible
	):
		ignore_shots = true
		_increase_ducks_shot()
		if show_duck_points:
			await _show_duck_points(_duck_hit_position)
		score_current += points_per_duck
		if present_hit_duck:
			await _dog_present_duck(_duck_hit_position, _duck_type)
		await _reload_shotgun()
		if ducks_shot == ducks_to_shoot_per_round:
			await _round_complete()
			await _start_next_round()
		await get_tree().create_timer(0.8).timeout
		await _spawn_duck()
		ignore_shots = false
	# Special case: intro screen continued (exited)
	elif intro_screen.visible:
		if (
				_duck_hit_position != Vector2.ZERO
				and intro_screen.get_node("ContinueLabel")
		):
			print("Intro screen duck shot")
			intro_screen.get_node("AnimationPlayer").stop()
			intro_screen.get_node("ContinueLabel").hide()
			if active_duck.get_node("CursorManager"):
				active_duck.get_node("CursorManager").set_default_cursor()
		await get_tree().create_timer(0.5).timeout
		intro_screen_continued.emit()
	# In all other cases: Do nothing.
	else:
		pass


func _show_duck_points(_duck_hit_position):
	bell_player.play()
	duck_points_label.text = str(points_per_duck)
	#print("duck_points_label.position: " + str(duck_points_label.position))
	duck_points_label.position = Vector2(
			roundi(_duck_hit_position.x - (duck_points_label.size.x/2)),
			roundi(_duck_hit_position.y - (duck_points_label.size.y * 0.75)),
	)
	#print("duck_points_label.position: " + str(duck_points_label.position))
	duck_points_label.z_index = 999
	duck_points_label.show()
	await get_tree().create_timer(show_duck_points_delay).timeout
	duck_points_label.hide()


func _start_next_round():
	round_complete_sign.hide()
	print("All " + str(ducks_to_shoot_per_round) + " ducks shot")
	print("Starting next round...")
	round_current += 1
	await _reset_ducks_shot()
	print("\nRound " + str(round_current))
	await _show_round_start_sign()
	if play_dog_intro:
		dog_node.position = dog_start_position
		#print("dog_node.position: " + str(dog_node.position))
		#print("dog_node.velocity: " + str(dog_node.velocity))
		dog_node.velocity = Vector2(1, 0) * dog_node.speed
		await _dog_jump_into_grass()


# Called on any sort of input.
# We're only interested in the action "left_click" though,
# which was defined in the Input Map in the project settings
# TODO: What action do we need for mobile devices?
func _input(event):
	if party_mode:
		var _credits_screen_party = intro_screen.get_node("CreditsScreen")
		if (
				event.is_action_pressed("left_click")
				and intro_screen.visible
				and not info_elements.visible
				and intro_screen_timer.is_stopped()
				and not _credits_screen_party.visible
		):
			shotgun_shot_player.play()
		# A keyboard escape from the title card, on top of the two timers. Someone watching a
		# game they cannot start because of a dead ball should not have to wait out a timeout
		# they have no way of knowing about.
		if (
				event.is_action_pressed("ui_accept")
				and intro_screen.visible
				and intro_screen_timer.is_stopped()
				and not _credits_screen_party.visible
		):
			print("Intro screen skipped by key press")
			_finish_intro_screen()
		return
	if event.is_action_pressed("left_click"):
		var _credits_screen = intro_screen.get_node("CreditsScreen")
		# During normal game, enough bullets left
		if bullets_current >= 1 and not ignore_shots:
			shotgun_shot_player.play()
			_set_bullets(bullets_current - 1)
			# Whether the duck was ALREADY down before this shot. duck_hit stays true for the
			# rest of the round, so comparing against it afterwards is the only way to tell
			# "this shot hit" from "some earlier shot did" - which is the difference between
			# a miss cue and no cue at all.
			var _was_hit := false
			if get_node_or_null(NodePath("Duck")):
				_was_hit = duck.duck_hit
			var _shot_at := _shot_position(event)
			# Attention:
			# Give the Duck scene a chance to check if duck was hit or not!
			# Otherwise the 3rd shot will never be able to hit a duck!
			await get_tree().create_timer(0.01).timeout
			# Prevent error "Invalid set index", by checking if duck still exists or not
			# See https://ask.godotengine.org/109379/invalid-index-visible-base-null-instance-with-value-type-bool
			# and https://docs.godotengine.org/en/stable/classes/class_node.html#class-node-method-get-node-or-null
			var _duck_hit = false
			var _duck_alive := get_node_or_null(NodePath("Duck")) != null
			if _duck_alive:
				_duck_hit = duck.duck_hit
			else:
				_duck_hit = true
			# Whether THIS shot brought the duck down. Note _duck_hit is not that test: it is
			# also set true when the duck node has already gone (so that a duck which escaped
			# does not trigger game over), and it stays true for every later shot in the
			# round. Only a shot that flipped it from false to true actually connected.
			if not (_duck_alive and _duck_hit and not _was_hit):
				_play_web_shot_miss(_shot_at)
			# If last shot fired without hit -> Game Over!
			if (
					bullets_current == 0
					and game_over_timer.is_stopped()
					and not _duck_hit
			):
				duck.input_pickable = false
				ignore_shots = true
				print("Last bullet shot without hit!")
				# Shots will be enabled again after game got reloaded by game over timeout...
				_game_over()
		# Intro screen exitable & credits not showing
		elif (
				intro_screen.visible
				and not info_elements.visible
				and intro_screen_timer.is_stopped()
				and not _credits_screen.visible
		):
			shotgun_shot_player.play()
		# Credits screen
		elif _credits_screen.visible:
			pass
		# Any situation in which shots are not desired,
		# but we want to give the player some feedback
		# (credits not showing)
		# Reminder: This case also applies to highscore screen
		else:
			shotgun_empty_player.play()
			await get_tree().create_timer(0.01).timeout


func _game_over():
	print("\nGAME OVER!")
	# The dog is about to laugh, which moves the same node. Any retrieval still queued would
	# fight it for position, and it is answering a hit from the game that just ended.
	dog_present_queue.clear()
	_dog_laugh()
	game_over_sign.show()
	game_over_player.play()
	if game_over_timer.is_stopped():
		print("wait_time from main scene: " + str (game_over_timer.wait_time))
		if game_over_timer.wait_time < game_over_timeout_sec_min:
			game_over_timer.wait_time = game_over_timeout_sec_min
			print("wait_time set to minimum: " + str (game_over_timer.wait_time))
		game_over_timer.start()


func _on_game_over_timeout():
	dog_node.get_node("DogLaughPlayer").stop()
	game_over_sign.hide()
	await _show_highscore_screen()
	# TODO: Refactor this to _start_next_round(), see what _ready() does different!
	print("Restarting game...\n")
	get_tree().reload_current_scene()


func _increase_ducks_shot():
	ducks_shot += 1
	### For debugging/testing only!
	if debug_round_mode and ducks_shot < ducks_to_shoot_per_round:
		ducks_shot = ducks_to_shoot_per_round
	###
	print("shot duck #" + str(ducks_shot))
	var _ducks_shot_region = ducks_shot_sprite.get_region_rect()
	if ducks_shot <= ducks_to_shoot_per_round:
		_ducks_shot_region = Rect2(
				_ducks_shot_region.position,
				Vector2(
						ducks_shot_sprite_default_width + (ducks_shot * ducks_shot_width),
						_ducks_shot_region.size.y,
				),
		)
		ducks_shot_sprite.set_region_rect(_ducks_shot_region)
	# TODO: Make this configurable?
	if ducks_shot == ducks_to_shoot_per_round:
		await get_tree().create_timer(1).timeout
	else:
		await get_tree().create_timer(0.5).timeout


func _reset_ducks_shot():
	ducks_shot = 0
	var _ducks_shot_region = ducks_shot_sprite.get_region_rect()
	_ducks_shot_region = Rect2(
			_ducks_shot_region.position,
			Vector2(
					1,
					_ducks_shot_region.size.y,
			)
	)
	ducks_shot_sprite.set_region_rect(_ducks_shot_region)


func _round_complete():
	success_player.play()
	var _bonus_pts = bonus_pts_per_round_multiplier * round_current
	var _round_complete_msg = round_complete_msg_prefix + format_score(str(_bonus_pts))
	round_complete_sign.get_node("Label").text = _round_complete_msg
	round_complete_sign.show()
	score_current += _bonus_pts
	if play_round_complete_animation:
		for i in range(round_compl_anim_blink_cnt):
			ducks_shot_sprite.hide()
			await get_tree().create_timer(round_compl_anim_blink_delay).timeout
			ducks_shot_sprite.show()
			await get_tree().create_timer(round_compl_anim_blink_delay).timeout
		ducks_shot_sprite.show()
		await get_tree().create_timer(round_compl_anim_blink_delay).timeout
	else:
		await get_tree().create_timer(1.5).timeout
	if success_player.is_playing():
		success_player.stop()
	round_complete_sign.hide()
	await get_tree().create_timer(round_complete_msg_delay_after).timeout


func _set_bullets(bullets_new):
	bullets_current = bullets_new
	print("bullets_current: " + str(bullets_current))
	var _bullets_region = bullets_sprite.get_region_rect()
	_bullets_region = Rect2(
		_bullets_region.position,
		Vector2(
			bullets_current * bullets_width,
			_bullets_region.size.y,
		)
	)
	bullets_sprite.set_region_rect(_bullets_region)


func _play_shot_with_shell() -> void:
	shotgun_shot_player.play()
	await get_tree().create_timer(0.22).timeout
	if is_instance_valid(shotgun_reload_player):
		shotgun_reload_player.play()


func _reload_shotgun():
	print("shotgun reload")
	_set_bullets(maxi(max_bullets, party_player_count * 99) if party_mode else max_bullets)
	shotgun_reload_player.play()


func _get_gripball_player_target(player_id: int):
	if intro_screen.visible:
		var intro_duck = intro_party_ducks.get(player_id)
		if intro_duck and is_instance_valid(intro_duck) and intro_duck.get("input_pickable"):
			return intro_duck.global_position
		return null
	var target_duck = party_ducks.get(player_id)
	if not target_duck or not is_instance_valid(target_duck):
		return null
	if not target_duck.get("input_pickable"):
		return null
	return target_duck.global_position


func _on_gripball_player_shot(player_id: int, aim_position := Vector2.ZERO) -> void:
	if intro_screen.visible:
		if intro_screen_timer.is_stopped():
			shotgun_shot_player.play()
			if party_mode:
				var intro_duck = intro_party_ducks.get(player_id)
				# The intro screen is where the aim tone is heard for the first time, before
				# the round starts and the score matters, so it answers misses too - that is
				# how a player works out what the trill going silent was telling them.
				var intro_landed := false
				if intro_duck and is_instance_valid(intro_duck) and intro_duck.get("input_pickable"):
					var intro_collision := intro_duck.get_node_or_null("CollisionShape2D") as CollisionShape2D
					if (
						intro_collision
						and intro_collision.shape
						and intro_collision.shape.get_rect().has_point(intro_collision.to_local(aim_position))
					):
						intro_landed = true
						intro_players_hit[player_id] = true
						intro_duck.shoot()
						# Only players whose ball has been proven to press are waited for. A ball
						# that cannot engage cannot hit anything, so counting it here is what used
						# to hang the game on the title card - see _intro_required_players.
						var all_hit := true
						for required_id in _intro_required_players():
							if not bool(intro_players_hit.get(required_id, false)):
								all_hit = false
								break
						if all_hit:
							# Stop the blinking before the beat, not after it: the prompt has been
							# answered, so leaving it flashing through the pause reads as though
							# the shot did not register.
							intro_screen.get_node("AnimationPlayer").stop()
							intro_screen.get_node("ContinueLabel").hide()
							await get_tree().create_timer(0.7).timeout
							_finish_intro_screen()
						else:
							# One duck down proves the input path works, so anybody still missing is
							# a hardware problem rather than a slow player. Give them a short grace
							# period and then go regardless.
							_start_intro_grace()
				if not intro_landed:
					_play_web_shot_miss(aim_position, player_id)
			elif duck:
				duck.shoot()
		return
	if not party_mode or ignore_shots:
		return
	var target_duck = party_ducks.get(player_id)
	if not target_duck or not is_instance_valid(target_duck):
		shotgun_empty_player.play()
		await get_tree().create_timer(0.22).timeout
		if is_instance_valid(shotgun_reload_player):
			shotgun_reload_player.play()
		return
	_play_shot_with_shell()
	var collision := target_duck.get_node_or_null("CollisionShape2D") as CollisionShape2D
	if collision and collision.shape and collision.shape.get_rect().has_point(collision.to_local(aim_position)):
		target_duck.shoot()
	else:
		# Miss. Placed at the crosshair rather than at the duck: this is feedback about where
		# the player's own shot went, so it has to come from where they were pointing - a miss
		# that sounds from the duck's position would read as a hit that failed to register.
		_play_web_shot_miss(aim_position, player_id)


# Where the shot was aimed, in viewport coordinates. Gripball shots arrive here as synthetic
# InputEventMouseButtons carrying the crosshair's own position (gripball_input's _send_click
# sets event.position = virtual_position), so the event is the right source for both input
# methods and there is no need to reach into GripballInput. Falls back to the real mouse for
# any event that has no position of its own.
func _shot_position(event) -> Vector2:
	if event is InputEventMouse:
		return (event as InputEventMouse).position
	return get_viewport().get_mouse_position()


# The counterpart to the aim tone: aiming raises a trill that goes silent on lock-on, and a
# shot that finds nothing answers with this. Web-only and spatialized through the same
# measured-HRIR path as the duck sounds (window.duckHuntSpatialAudio.play). There is no
# desktop fallback on purpose - off the web the aim tone does not exist either, so a lone
# miss sound would be answering a question the player was never asked.
func _play_web_shot_miss(at_position: Vector2, player_id: int = 0) -> bool:
	if not OS.has_feature("web"):
		return false
	# Viewport size travels with the position for the same reason as the duck sounds: x/y are
	# viewport coordinates, and window.innerWidth is a different space once letterboxed.
	var viewport_size := get_viewport().get_visible_rect().size
	var expression := (
		"window.duckHuntSpatialAudio ? " +
		"(window.duckHuntSpatialAudio.play(\"shot_miss\", %f, %f, %f, %f, %d), true) : false"
	) % [at_position.x, at_position.y, viewport_size.x, viewport_size.y, maxi(player_id, 0)]
	return bool(JavaScriptBridge.eval(expression, true))


func _show_round_start_sign():
	var _round_start_msg = round_start_msg_prefix + str(round_current)
	round_start_sign.get_node("Label").text = _round_start_msg
	round_start_sign.show()
	await get_tree().create_timer(round_start_msg_delay).timeout
	round_start_sign.hide()


# Format score with seperator every 3 digits
# Taken from:
# https://ask.godotengine.org/18559/how-to-add-commas-to-an-integer-or-float-in-gdscript?show=116174#a116174
func format_score(_score: String) -> String:
	var _i = _score.length() - 3
	while _i > 0:
		_score = _score.insert(_i, score_seperator)
		_i = _i - 3
	return _score
