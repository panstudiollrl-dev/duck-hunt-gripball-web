extends Node

signal calibration_finished
signal players_changed(count: int)
signal player_shot(player_id: int)
# Emitted the first time a given ball produces a press big enough to count as one. Enrolment
# alone does not prove a ball works: it can be authorized, streaming, and still never engage.
signal player_proven(player_id: int)

const PORT := 8001
const FEEDBACK_PORT := 8002
const TRACK_SPEED_MIN := 45.0
const TRACK_SPEED_MAX := 300.0
const PARTY_TRACK_SPEED_MIN := 55.0
const PARTY_TRACK_SPEED_MAX := 255.0
# The aim-tracking tone is a continuous pitch bend, so it needs updates far more often than
# the 0.22s proximity feedback - at that rate the pitch would move in audible steps. 30Hz is
# frequent enough to sound continuous once the JS side smooths between updates, without
# calling into JavaScriptBridge every single frame.
const TRACK_TONE_INTERVAL := 1.0 / 30.0
# Closeness is measured against a fraction of the screen diagonal, matching the existing
# proximity calculation so the audio and the (disabled) haptics agree on what "close" means.
const TRACK_TONE_RANGE := 0.65
# Party Mode's targets arrive as bare positions (_get_gripball_player_target returns a
# Vector2), so there is no hitbox to test against the way single player does. This radius
# stands in for one: it is a little wider than the duck's own collision circle, so a
# crosshair that has visibly arrived counts as arrived even if it is a pixel or two off.
const TRACK_LOCK_RADIUS := 22.0
# Below this the grip counts as released, which is what ends a tone segment and arms the
# next one. Same threshold the crosshair texture already switches on.
const TRACK_PRESS_FLOOR := 0.01
var udp := PacketPeerUDP.new()
var feedback_udp := PacketPeerUDP.new()
var virtual_position := Vector2.ZERO
var crosshair: Sprite2D
var crosshair_white: Texture2D
var crosshair_red: Texture2D
var tracking_strength := 0.0
var calibration_complete := false
var party_mode := false
var player_count := 0
var party_crosshairs := {}
var party_positions := {}
var party_strengths := {}
# player_id -> true once that ball has been seen to press. Read by main.gd's intro screen so it
# only waits on players who can actually shoot.
var players_proven := {}
# One flag per player: has this press already reached the duck? Set on arrival, cleared on
# release. While set, the player emits no tone - the reward for arriving is silence, and the
# next press is what buys a new sweep.
var party_tone_spent := {}
# player_id -> when their fire lock-out ends, in the same seconds-since-boot clock main.gd uses.
# Set by set_player_locked() after a miss; while it holds, that crosshair dims and stops tracking.
var party_locked_until := {}
# player_id -> which duck main.gd last steered them at, so a change of target can re-arm the tone.
var party_target_keys := {}
var party_layer: CanvasLayer
var status_label: Label
var step_label: Label
var progress_bar: ProgressBar
var calibration_panel: ColorRect
var value_label: Label
var last_feedback_time := 0.0
var last_track_tone_time := 0.0
var track_tone_active := false
var tone_spent := false
var web_mode := false


func _ready() -> void:
	# Keep the real OS cursor available for menus such as Continue. Gripball
	# input uses its own Sprite2D crosshair and never moves the OS pointer.
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	virtual_position = get_viewport().get_visible_rect().size * 0.5
	_create_crosshair()
	_create_status_label()
	web_mode = OS.has_feature("web")
	if web_mode:
		_setup_web_input()
		return
	var result = udp.bind(PORT, "127.0.0.1")
	feedback_udp.set_dest_address("127.0.0.1", FEEDBACK_PORT)
	if result == OK:
		print("Gripball UDP input listening on 127.0.0.1:", PORT)
	else:
		push_error("Gripball UDP input could not bind: " + str(result))


func _notification(what: int) -> void:
	if what == NOTIFICATION_APPLICATION_FOCUS_IN:
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	elif what == NOTIFICATION_APPLICATION_FOCUS_OUT:
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE


func _process(_delta: float) -> void:
	if web_mode:
		_poll_web_input()
	while udp.get_available_packet_count() > 0:
		var message = JSON.parse_string(udp.get_packet().get_string_from_utf8())
		_handle_message(message)
	_update_tracking(_delta)


func _handle_message(message: Variant) -> void:
	if not message is Dictionary:
		return
	if message.get("type") == "aim":
		var viewport := get_viewport()
		virtual_position += Vector2(
			float(message.get("dx", 0.0)),
			float(message.get("dy", 0.0))
		)
		virtual_position = virtual_position.clamp(
			Vector2.ZERO,
			viewport.get_visible_rect().size
		)
		crosshair.position = virtual_position
	elif message.get("type") == "aim_abs":
		var size := get_viewport().get_visible_rect().size
		virtual_position = Vector2(
			clampf(float(message.get("x", 0.5)), 0.0, 1.0) * size.x,
			clampf(float(message.get("y", 0.5)), 0.0, 1.0) * size.y
		)
		crosshair.position = virtual_position
	elif message.get("type") == "shoot":
		_send_click(true)
		_send_click(false)
	elif message.get("type") == "player_count":
		party_mode = true
		var new_player_count := maxi(int(message.get("count", 1)), 1)
		crosshair.hide()
		if new_player_count != player_count or party_crosshairs.is_empty():
			player_count = new_player_count
			# The JS side re-indexes players whenever one connects or disconnects, so after a
			# count change a stored player_id refers to a different ball. Keeping the old flags
			# would credit a new ball with a proven-ness it has not earned, so they are dropped
			# and each ball proves itself again on its next press.
			players_proven.clear()
			_setup_party_crosshairs(player_count)
			players_changed.emit(player_count)
	elif message.get("type") == "shoot_player":
		party_mode = true
		var player_id := maxi(int(message.get("player", 0)), 0)
		player_shot.emit(player_id)
		var scene := get_tree().current_scene
		if scene and scene.has_method("_on_gripball_player_shot"):
			scene._on_gripball_player_shot(player_id, party_positions.get(player_id, virtual_position))
		else:
			_send_click(true)
			_send_click(false)
	elif message.get("type") == "player_proven":
		# This ball has produced a real press for the first time. Only now is it known to be a
		# working controller rather than just an enrolled device - see the intro screen, which
		# would otherwise wait forever for a ball that cannot engage.
		party_mode = true
		var proven_id := maxi(int(message.get("player", 0)), 0)
		if not players_proven.has(proven_id):
			players_proven[proven_id] = true
			player_proven.emit(proven_id)
	elif message.get("type") == "track_player":
		party_mode = true
		var track_player_id := maxi(int(message.get("player", 0)), 0)
		var strength := clampf(float(message.get("value", 0.0)), 0.0, 1.0)
		party_strengths[track_player_id] = strength
		if party_crosshairs.has(track_player_id):
			party_crosshairs[track_player_id].texture = crosshair_red if strength > 0.01 else crosshair_white
	elif message.get("type") == "track_strength":
		if party_mode:
			return
		tracking_strength = clampf(float(message.get("value", 0.0)), 0.0, 1.0)
		crosshair.texture = crosshair_red if tracking_strength > 0.01 else crosshair_white
	elif message.get("type") == "calibration":
		status_label.text = str(message.get("text", "Calibrating..."))
		step_label.text = str(message.get("step", "CALIBRATION"))
		progress_bar.value = float(message.get("progress", 0.0))
		value_label.text = "RAW %s   BASE %s   FORCE %s" % [
			str(message.get("raw", "--")),
			str(message.get("baseline", "--")),
			str(message.get("force", "--")),
		]
		calibration_panel.show()
	elif message.get("type") == "calibration_done":
		calibration_panel.hide()
		if not party_mode:
			crosshair.show()
		if not calibration_complete:
			calibration_complete = true
			calibration_finished.emit()


func _setup_web_input() -> void:
	var script := FileAccess.get_file_as_string("res://web/gripball_webhid.js")
	if script.is_empty():
		push_error("WebHID controller script is missing")
		return
	JavaScriptBridge.eval(script, true)


func _poll_web_input() -> void:
	var payload = JavaScriptBridge.eval(
		"window.gripballBridge ? window.gripballBridge.poll() : '[]'", true
	)
	if not payload is String or payload.is_empty():
		return
	var messages = JSON.parse_string(payload)
	if messages is Array:
		for message in messages:
			_handle_message(message)


func _create_crosshair() -> void:
	var layer := CanvasLayer.new()
	layer.layer = 1000
	add_child(layer)
	party_layer = CanvasLayer.new()
	party_layer.layer = 1000
	add_child(party_layer)
	crosshair = Sprite2D.new()
	crosshair_white = load("res://assets/cursors/crosshairs_white.png")
	crosshair_red = load("res://assets/cursors/crosshairs_red.png")
	crosshair.texture = crosshair_white
	crosshair.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	crosshair.scale = Vector2(0.25, 0.25)
	crosshair.position = virtual_position
	crosshair.z_index = 1000
	crosshair.hide()
	layer.add_child(crosshair)


func _setup_party_crosshairs(count: int) -> void:
	if not party_layer:
		return
	for child in party_layer.get_children():
		child.queue_free()
	party_crosshairs.clear()
	party_positions.clear()
	party_strengths.clear()
	party_tone_spent.clear()
	party_locked_until.clear()
	party_target_keys.clear()
	var size := get_viewport().get_visible_rect().size
	for player_id in range(count):
		var sprite := Sprite2D.new()
		sprite.texture = crosshair_white
		sprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		sprite.scale = Vector2(0.20, 0.20)
		sprite.z_index = 1000
		var position := Vector2(
			size.x * (float(player_id) + 0.5) / float(count),
			size.y * 0.55
		)
		sprite.position = position
		party_positions[player_id] = position
		party_strengths[player_id] = 0.0
		party_tone_spent[player_id] = false
		party_layer.add_child(sprite)
		party_crosshairs[player_id] = sprite
		var label := Label.new()
		label.text = str(player_id + 1)
		label.position = Vector2(-8, -28)
		label.size = Vector2(16, 12)
		label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		label.add_theme_font_size_override("font_size", 9)
		label.add_theme_color_override("font_color", Color(1.0, 0.75, 0.12))
		label.add_theme_color_override("font_outline_color", Color.BLACK)
		label.add_theme_constant_override("outline_size", 3)
		sprite.add_child(label)


func _create_status_label() -> void:
	var layer := CanvasLayer.new()
	layer.layer = 1001
	add_child(layer)
	calibration_panel = ColorRect.new()
	var viewport_size := get_viewport().get_visible_rect().size
	calibration_panel.size = Vector2(
		minf(190.0, viewport_size.x - 24.0),
		minf(116.0, viewport_size.y - 36.0)
	)
	calibration_panel.position = (viewport_size - calibration_panel.size) * 0.5
	calibration_panel.color = Color(0.03, 0.06, 0.10, 0.94)
	layer.add_child(calibration_panel)
	var title := Label.new()
	title.position = Vector2(6, 6)
	title.size = Vector2(calibration_panel.size.x - 12, 12)
	title.text = "GRIP SETUP"
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title.add_theme_font_size_override("font_size", 5)
	title.add_theme_color_override("font_color", Color(1.0, 0.72, 0.18))
	calibration_panel.add_child(title)
	step_label = Label.new()
	step_label.position = Vector2(6, 20)
	step_label.size = Vector2(calibration_panel.size.x - 12, 11)
	step_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	step_label.add_theme_font_size_override("font_size", 5)
	step_label.text = "CONNECTING..."
	calibration_panel.add_child(step_label)
	status_label = Label.new()
	status_label.position = Vector2(8, 35)
	status_label.size = Vector2(calibration_panel.size.x - 16, 32)
	status_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	status_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	status_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	status_label.add_theme_font_size_override("font_size", 6)
	status_label.add_theme_color_override("font_outline_color", Color.BLACK)
	status_label.add_theme_constant_override("outline_size", 2)
	status_label.text = "Waiting for Gripballs..."
	calibration_panel.add_child(status_label)
	progress_bar = ProgressBar.new()
	value_label = Label.new()
	value_label.position = Vector2(6, 72)
	value_label.size = Vector2(calibration_panel.size.x - 12, 10)
	value_label.text = "RAW --   BASE --   FORCE --"
	value_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	value_label.add_theme_font_size_override("font_size", 5)
	value_label.add_theme_color_override("font_color", Color(0.72, 0.90, 1.0))
	calibration_panel.add_child(value_label)
	progress_bar.position = Vector2(12, 86)
	progress_bar.size = Vector2(calibration_panel.size.x - 24, 8)
	progress_bar.min_value = 0
	progress_bar.max_value = 100
	progress_bar.show_percentage = false
	calibration_panel.add_child(progress_bar)
	var hint := Label.new()
	hint.position = Vector2(6, 99)
	hint.size = Vector2(calibration_panel.size.x - 12, 10)
	hint.text = "CONNECT THEN START"
	hint.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	hint.add_theme_font_size_override("font_size", 5)
	hint.add_theme_color_override("font_color", Color(0.65, 0.72, 0.78))
	calibration_panel.add_child(hint)


func _update_tracking(delta: float) -> void:
	if party_mode:
		_update_party_tracking(delta)
		return
	if tracking_strength <= TRACK_PRESS_FLOOR:
		# Released: arm the next press. Nothing else clears this flag, so one press can only
		# ever produce one sweep no matter how long it is held.
		tone_spent = false
		_send_track_tones([])
		return
	var duck := get_tree().current_scene.find_child("Duck", true, false)
	if not duck or not duck.get("input_pickable"):
		# No duck to aim at, so there is nothing for the tone to report.
		_send_track_tones([])
		return
	var target: Vector2 = duck.global_position
	var speed := lerpf(TRACK_SPEED_MIN, TRACK_SPEED_MAX, tracking_strength)
	virtual_position = virtual_position.move_toward(target, speed * delta)
	crosshair.position = virtual_position
	var closeness := _closeness_to(virtual_position, target)
	# Uses the duck's real hitbox, the same test _try_hit_duck() does, so the tone ending
	# means exactly "a shot right now would land" rather than "quite close".
	if _is_on_duck(virtual_position, duck):
		tone_spent = true
	if tone_spent:
		# Arrived earlier in this same press. Staying silent is the point: the sweep is the
		# sound of closing in, and tracking assist parks the crosshair on the duck, so a tone
		# that resumed here would just drone for the rest of the hold.
		_send_track_tones([])
	else:
		_send_track_tones([{
			"id": 0,
			"x": virtual_position.x,
			"y": virtual_position.y,
			"closeness": closeness,
			"locked": false,
		}])
	var now := Time.get_ticks_msec() / 1000.0
	if now - last_feedback_time >= 0.22:
		var intensity := roundi(20.0 + closeness * 75.0)
		if web_mode:
			JavaScriptBridge.eval(
				"window.gripballBridge && window.gripballBridge.proximity(%d)" % intensity,
				true
			)
		else:
			feedback_udp.put_packet(
				JSON.stringify({"type": "proximity", "intensity": intensity}).to_utf8_buffer()
			)
		last_feedback_time = now


func _update_party_tracking(delta: float) -> void:
	if party_crosshairs.is_empty():
		_send_track_tones([])
		return
	var scene := get_tree().current_scene
	var viewport_size := get_viewport().get_visible_rect().size
	# One entry per player who is actively tracking. Collected across the whole loop and sent
	# once, so the JS side can share gain between however many voices are sounding.
	var tones: Array = []
	for player_id in party_crosshairs.keys():
		var sprite: Sprite2D = party_crosshairs[player_id]
		var strength := float(party_strengths.get(player_id, 0.0))
		var current: Vector2 = party_positions.get(player_id, sprite.position)
		var locked := is_player_locked(player_id)
		# Half-transparent while locked out. The crosshair also stops moving below, so the player
		# both sees the penalty and feels it - squeezing does nothing until it lifts.
		sprite.modulate.a = 0.35 if locked else 1.0
		if locked:
			party_positions[player_id] = current
			sprite.position = current
			continue
		if strength <= TRACK_PRESS_FLOOR:
			# Released: arm this player's next press. Per player, so one player letting go
			# does not re-arm anybody else.
			party_tone_spent[player_id] = false
			party_positions[player_id] = current
			sprite.position = current
			continue
		var target := Vector2.ZERO
		var has_target := false
		if scene and scene.has_method("_get_gripball_player_target"):
			var raw_target = scene._get_gripball_player_target(player_id)
			if raw_target is Vector2:
				target = raw_target
				has_target = true
		if not has_target:
			continue
		var speed := lerpf(PARTY_TRACK_SPEED_MIN, PARTY_TRACK_SPEED_MAX, strength)
		current = current.move_toward(target, speed * delta)
		current = current.clamp(Vector2.ZERO, viewport_size)
		party_positions[player_id] = current
		sprite.position = current
		# Re-arm on a change of target, even mid-squeeze. party_tone_spent exists so that one long
		# hold cannot drone (the reward for arriving is silence), but with a shared flock the
		# crosshair now gets handed a NEW duck without the player releasing - because they took
		# the last one, or somebody else did. Staying silent through that approach would withhold
		# the trill exactly when it is being used to time a contested shot.
		var target_key := 0
		if scene.has_method("_get_gripball_player_target_key"):
			target_key = int(scene._get_gripball_player_target_key(player_id))
		if target_key != int(party_target_keys.get(player_id, 0)):
			party_target_keys[player_id] = target_key
			party_tone_spent[player_id] = false
		if current.distance_to(target) <= TRACK_LOCK_RADIUS:
			party_tone_spent[player_id] = true
		if not bool(party_tone_spent.get(player_id, false)):
			tones.append({
				"id": player_id,
				"x": current.x,
				"y": current.y,
				"closeness": _closeness_to(current, target),
				"locked": false,
			})
	_send_track_tones(tones)


# Called by main.gd when a miss costs this player their next second or so (PARTY_MISS_LOCK_SEC).
#
# The lock is enforced in main.gd - this is only how it is shown. A penalty the player cannot see
# is indistinguishable from the game having lost their input, which is worse than no penalty: they
# would go looking for a broken ball instead of learning to hold their shot.
func set_player_locked(player_id: int, duration_sec: float) -> void:
	party_locked_until[player_id] = (Time.get_ticks_msec() / 1000.0) + duration_sec


func is_player_locked(player_id: int) -> bool:
	return (Time.get_ticks_msec() / 1000.0) < float(party_locked_until.get(player_id, 0.0))


func _is_on_duck(point: Vector2, duck: Node) -> bool:
	# Same geometry as _try_hit_duck(), so "the tone went silent" and "the shot would have
	# hit" can never disagree. Anything unexpected about the node counts as not-locked: a
	# tone that stays audible is a far smaller problem than one that goes silent on a miss.
	if not duck or not duck.get("input_pickable"):
		return false
	var collision := duck.get_node_or_null("CollisionShape2D") as CollisionShape2D
	if not collision or not collision.shape:
		return false
	return collision.shape.get_rect().has_point(collision.to_local(point))


func _closeness_to(from: Vector2, target: Vector2) -> float:
	# 1.0 when the crosshair is on the duck, falling to 0.0 once it is TRACK_TONE_RANGE of a
	# screen diagonal away. This is the pitch control: near duck -> high pitch.
	var diagonal := get_viewport().get_visible_rect().size.length()
	if diagonal <= 0.0:
		return 0.0
	var distance := from.distance_to(target)
	return 1.0 - clampf(distance / (diagonal * TRACK_TONE_RANGE), 0.0, 1.0)


func _send_track_tones(entries: Array) -> void:
	# Sends every currently-tracking crosshair at once. The JS side fades out any voice whose
	# id is absent from the list, so an empty array is also how tracking is stopped - there is
	# no separate stop call to keep in sync.
	if not web_mode:
		return
	var now := Time.get_ticks_msec() / 1000.0
	if entries.is_empty():
		if not track_tone_active:
			return
		track_tone_active = false
	else:
		if now - last_track_tone_time < TRACK_TONE_INTERVAL:
			return
		track_tone_active = true
	last_track_tone_time = now
	# Viewport size travels with the payload for the same reason as the duck sounds: x/y are
	# viewport coordinates, and window.innerWidth is a different space once letterboxed.
	var viewport_size := get_viewport().get_visible_rect().size
	var expression := (
		"window.duckHuntSpatialAudio && window.duckHuntSpatialAudio.syncTracking " +
		"? window.duckHuntSpatialAudio.syncTracking(%s, %f, %f) : false"
	) % [JSON.stringify(JSON.stringify(entries)), viewport_size.x, viewport_size.y]
	JavaScriptBridge.eval(expression, true)


func _send_click(pressed: bool) -> void:
	if pressed:
		_try_hit_duck()
	var event := InputEventMouseButton.new()
	event.button_index = MOUSE_BUTTON_LEFT
	event.button_mask = MOUSE_BUTTON_MASK_LEFT if pressed else 0
	event.pressed = pressed
	event.position = virtual_position
	event.global_position = event.position
	Input.parse_input_event(event)


func _try_hit_duck() -> void:
	var duck := get_tree().current_scene.find_child("Duck", true, false)
	if not duck or not duck.get("input_pickable"):
		return
	var collision := duck.get_node_or_null("CollisionShape2D") as CollisionShape2D
	if not collision or not collision.shape:
		return
	if collision.shape.get_rect().has_point(collision.to_local(virtual_position)):
		duck.shoot()
